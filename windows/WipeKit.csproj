<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WipeKit</AssemblyName>
    <RootNamespace>WipeKit</RootNamespace>
    <ApplicationIcon>..\assets\WipeKit.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.1</Version>
    <Product>WipeKit</Product>
    <Company>mllsm66</Company>
    <Copyright>© 2026 mllsm66 – MIT-Lizenz</Copyright>
    <Description>Laufwerke sicher löschen und ihre Gesundheit prüfen</Description>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);WPF0001;CA1416</NoWarn>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\assets\WipeKit.ico" Link="WipeKit.ico" />
    <EmbeddedResource Include="..\assets\report-logo.jpg" LogicalName="WipeKit.report-logo.jpg" />
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.md" LogicalName="WipeKit.THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="..\licenses\GPL-2.0.txt" LogicalName="WipeKit.GPL-2.0.txt" />
    <!-- smartctl.exe aus smartmontools 7.5 (GPL-2.0-or-later), wird im Build von GitHub nach vendor\ geladen -->
    <EmbeddedResource Include="vendor\smartctl.exe" LogicalName="WipeKit.smartctl.exe" Condition="Exists('vendor\smartctl.exe')" />
  </ItemGroup>

</Project>
